{
  "name": "emailmanager",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "clean": "pnpm db:clean && turbo run clean && rm -rf node_modules",
    "db:clean": "docker rm -f -v emailmanager_postgres_dev emailmanager_postgres_test 2>/dev/null; docker volume rm -f emailmanager_postgres_data_dev emailmanager_postgres_data_test 2>/dev/null; exit 0",
    "db:migrate-up": "pnpm db:up && turbo run db:migrate-up",
    "db:migrate-up:test": "pnpm db:up:test && turbo run db:migrate-up:test",
    "db:up": "./tools/scripts/ensure_postgres_up.sh -p 5450 -c emailmanager_postgres_dev -v emailmanager_postgres_data_dev",
    "db:up:test": "./tools/scripts/ensure_postgres_up.sh -p 5451 -c emailmanager_postgres_test -v emailmanager_postgres_data_test",
    "format": "prettier --write . && turbo run format",
    "lint": "prettier --check . && turbo run lint",
    "serve:backend": "turbo run serve --filter=@emailmanager/emailmanager-core",
    "serve:web": "pnpm --filter @emailmanager/emailmanager-web dev",
    "start": "./start.sh",
    "stop": "./stop.sh",
    "sync": "pnpm install && pnpm db:migrate-up && pnpm db:migrate-up:test",
    "test": "turbo run test",
    "test:e2e:web": "pnpm --filter @emailmanager/e2e-tests-web test:e2e",
    "test:force": "turbo run test --force"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
